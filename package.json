{
  "name": "interviewpilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:extension\"",
    "dev:frontend": "npm --prefix interviewpilot-frontend run dev",
    "dev:backend": "npm --prefix interviewpilot-backend run dev",
    "dev:extension": "npm --prefix interviewpilot-extension run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}